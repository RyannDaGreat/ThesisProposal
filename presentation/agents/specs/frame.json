  {
   "title": null,
   "elements": [
    {
     "kind": "text",
     "text": "How to Control Your (Video) Diffusion Model",
     "rect": [
      40,
      190,
      880,
      110
     ],
     "size": 44,
     "color": "#000000"
    },
    {
     "kind": "text",
     "text": "Ryan Burgert, Stony Brook University",
     "rect": [
      40,
      320,
      880,
      40
     ],
     "size": 24,
     "color": "#000000"
    }
   ],
   "speech": "I'm Ryan Burgert, I'm a PhD student here at Stony Brook, and this is my thesis: how to control your video diffusion model. Five papers, one question. Let me show you the question first."
  },
